{
  "manifest_version": 3,
  "name": "BW Lite",
  "version": "0.2.0",
  "description": "Minimal unofficial Bitwarden/Vaultwarden client: search, copy, autofill, TOTP, add and edit logins.",
  "homepage_url": "https://github.com/yowmamasita/bw-lite",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
